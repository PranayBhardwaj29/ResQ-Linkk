# ResQ Linkk Environment Variables Example
# Copy this file to .env (or web-source/server/.env for backend)

# ── Backend / Supabase Edge Functions Secrets (NEVER expose to client) ──
TINYFISH_API_KEY=your_tinyfish_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ── Client-side Supabase credentials (optional, falls back gracefully) ──
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
