# Copy this file to .env and fill in your API keys.
# NEVER commit .env to git — it contains secret credentials.

# TinyFish API key for live disaster alerts, shelter extraction, and official web browsing
# Get your key from: https://tinyfish.ai
TINYFISH_API_KEY=your_tinyfish_api_key_here

# Gemini API key for AI assistant and situation briefings
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Port the Express server listens on (default: 3001)
PORT=3001
